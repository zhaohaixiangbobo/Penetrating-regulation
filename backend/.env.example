# ============================================================
# 审计监管系统 - 服务器环境配置模板
# 使用方法：复制为 .env 后按实际环境修改
#   cp .env.example .env
# 注意：.env 必须放在 backend/ 目录下（与 app/ 同级）
# ============================================================

# StarRocks 连接（信创/aarch64 部署使用 aiomysql 纯 Python 驱动）
# 密码中的特殊字符需 URL 编码，例如 # 编码为 %23
STARROCKS_URL=mysql+aiomysql://root:TJycrock%23lc2025@10.9.14.128:9030/eap_adb?charset=utf8mb4

# 本地 SQLite（存储登录账号，相对路径基于 backend/ 目录）
SQLITE_URL=sqlite+aiosqlite:///./data/app.db

# JWT 密钥：生产环境务必改为一串随机长字符串（可用 openssl rand -hex 32 生成）
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# 登录令牌有效期（分钟），默认 8 小时
JWT_EXPIRE_MIN=480

# ============================================================
# 认证模式与 4A/OIDC 预留（默认 local，无需修改即维持现有账号密码登录）
#   AUTH_MODE=local ：本地 SQLite 账号 + 密码登录
#   AUTH_MODE=oidc  ：对接 4A 统一身份平台（OIDC 单点登录，需填写下方 OIDC_* 参数）
# ============================================================
AUTH_MODE=local
# 新建账号默认角色（admin / user）
DEFAULT_ROLE=user

# —— 以下 OIDC 参数仅在 AUTH_MODE=oidc 时需要填写（甲方提供）——
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile
# 不同 4A 平台的用户名/角色字段名可能不同，按对接文档调整
OIDC_USERNAME_CLAIM=preferred_username
OIDC_ROLE_CLAIM=role

# 允许跨域的来源：生产经 Nginx 同源部署（页面与接口同域，实际无跨域），保留默认即可；
# 下面同时列出生产访问地址（80 端口）与本地开发地址（8000 端口）
CORS_ORIGINS=http://10.9.14.128,http://localhost:8000,http://127.0.0.1:8000
